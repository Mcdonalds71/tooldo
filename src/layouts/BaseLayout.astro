---
import { ClientRouter } from 'astro:transitions';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import { SITE } from '../lib/site';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = SITE.description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL('/og/og.png', Astro.site);

// Cloudflare Web Analytics: cookieless page-view counting, the one thing /privacy
// names as ever acceptable to add. The token is per-Cloudflare-account, not a secret
// (it ships inside a public <script> tag every visitor's browser downloads), but it
// still lives in an env var rather than the repo — see docs/deploy.md — so a build
// without it configured (a fork, a local preview) just carries no beacon rather than
// someone else's token or a broken one.
const analyticsToken = import.meta.env.CF_ANALYTICS_TOKEN;

// Registered after load so fetching the shell never competes with rendering the page
// the visitor is actually looking at. Production only: the manifest the worker imports
// is written by the build, so in dev there would be nothing for it to import.
const REGISTER_WORKER = `if('serviceWorker' in navigator){
  addEventListener('load',function(){navigator.serviceWorker.register('/sw.js')})
}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#f4f0e7" />

    {
      /* The hero's showcase clips are served from Cloudinary, so the browser otherwise
         pays a DNS lookup, TCP handshake and TLS negotiation to a second origin before
         the first byte of video arrives. Warming the connection in the head overlaps
         all three with the rest of the page load. */
    }
    <link rel="preconnect" href="https://res.cloudinary.com" crossorigin />
    <link rel="dns-prefetch" href="https://res.cloudinary.com" />

    <link
      rel="preload"
      href="/fonts/clash-display-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-latin-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`The ${SITE.name} mark and wordmark`} />
    <meta name="twitter:card" content="summary_large_image" />

    <ClientRouter />

    {import.meta.env.PROD && <script is:inline set:html={REGISTER_WORKER} />}

    {
      analyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: analyticsToken })}
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
