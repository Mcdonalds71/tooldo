---
import { SITE } from '../lib/site';

/**
 * The wordmark as one enormous sticker across the full width of the page, flush to the
 * bottom edge — the last thing on the site, and the one place the brand gets to be
 * loud without a tool's work sitting next to it.
 *
 * SVG rather than an HTML heading with a `vw` font size, because `textLength` makes the
 * fit exact instead of approximate: the word is pinned to the full width of the viewBox
 * at every viewport, with `lengthAdjust="spacing"` letting the browser settle the
 * tracking rather than stretching the letterforms themselves. No magic `vw` number to
 * re-tune whenever the wordmark or the font changes, and no JavaScript to measure it.
 *
 * The viewBox is cut tight to the glyphs — "tooldo" has no descender, so the box runs
 * from the ascenders of the l and d down to the baseline, and the sticker sits flush on
 * the bottom of the page with no dead band under it.
 *
 * Decorative: the wordmark is already real text in the nav and in the footer's own
 * brand lockup, so this is hidden from assistive tech rather than read out a third time.
 *
 * The numbers below are measured off the real font rather than guessed, with canvas
 * `TextMetrics` against the loaded face: at a 300-unit size "tooldo" inks 201.56 above
 * the baseline and 4.69 below it (the overshoot on the round letters), and sets 957.9
 * wide naturally — close enough to the 1000-unit box that `textLength` has only ~8
 * units of tracking to add per gap, so the letterforms themselves stay untouched.
 */
const BOX_WIDTH = 1000;
const BOX_HEIGHT = 207;
const BASELINE = 202;
/** Wider than it needs to be: a soft gradient edge reads as a glow, a narrow one as a
 *  stripe. */
const SWEEP_BAND = 420;
---

<div
  class="sticker"
  style={`--sweep-band: ${SWEEP_BAND}px; --box-width: ${BOX_WIDTH}px`}
  aria-hidden="true"
>
  <svg class="sticker__art" viewBox={`0 0 ${BOX_WIDTH} ${BOX_HEIGHT}`}>
    <defs>
      <linearGradient id="sticker-sweep-fade" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#000" />
        <stop offset="0.5" stop-color="#fff" />
        <stop offset="1" stop-color="#000" />
      </linearGradient>

      {/* A soft-edged window travelling across the word. Masking a duplicate of the
          text — rather than animating a gradient fill — keeps the moving part a single
          rect the compositor can shift on its own. The black and white below are mask
          luminance, not palette colours: in a mask, black hides and white reveals. */}
      <mask
        id="sticker-sweep"
        maskUnits="userSpaceOnUse"
        x="0"
        y="0"
        width={BOX_WIDTH}
        height={BOX_HEIGHT}
      >
        <rect
          class="sticker__band"
          x={-SWEEP_BAND}
          y="0"
          width={SWEEP_BAND}
          height={BOX_HEIGHT}
          fill="url(#sticker-sweep-fade)"
        />
      </mask>
    </defs>

    {/* The die-cut sticker itself: two stacked copies of the same glyphs, not one.
        `.sticker__rim` is a solid ink silhouette pushed out by the wider of two
        strokes; `.sticker__face` sits on top with the narrower, paper-coloured
        stroke, covering the centre of the rim and leaving only its outer band
        showing — which is what reads as a dark die-cut edge around a paper-coloured
        sticker body, the same construction a real vinyl sticker is cut with. One
        stroke alone (what shipped before this) only ever gives one ring, and a
        sticker reads as a sticker because it has two. The drop-shadow is on this
        group, not on either text individually, so it traces the composite silhouette
        once rather than shadowing the rim and the face as two separate shapes. */}
    <g class="sticker__glyph">
      <text
        class="sticker__word sticker__rim"
        x="0"
        y={BASELINE}
        textLength={BOX_WIDTH}
        lengthAdjust="spacing"
      >
        {SITE.name}
      </text>
      <text
        class="sticker__word sticker__face"
        x="0"
        y={BASELINE}
        textLength={BOX_WIDTH}
        lengthAdjust="spacing"
      >
        {SITE.name}
      </text>
    </g>

    {/* The glow: a plain-filled, unstroked copy, so sweeping it only recolours the
        letterforms themselves rather than dragging a second ring through the mask. */}
    <text
      class="sticker__word sticker__glow"
      x="0"
      y={BASELINE}
      textLength={BOX_WIDTH}
      lengthAdjust="spacing"
      mask="url(#sticker-sweep)"
    >
      {SITE.name}
    </text>
  </svg>
</div>

<style>
  .sticker {
    /* Full bleed: the footer's own shell is capped at the content width, and this has
       to reach both edges of the screen regardless. */
    width: 100%;
    margin-top: var(--space-2xl);
    /* Clipped so the sweep's rect can start off-screen without widening the page. */
    overflow: hidden;
    line-height: 0;
  }

  .sticker__art {
    display: block;
    width: 100%;
    height: auto;
  }

  .sticker__glyph {
    filter: drop-shadow(0.018em 0.018em 0 rgba(0, 0, 0, 0.45));
  }

  .sticker__word {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    /* Sized so the natural width lands near the viewBox's own 1000 units — the closer
       it starts, the less tracking `lengthAdjust` has to add or take away. */
    font-size: 300px;
  }

  /* The outer ring: a solid ink blob, oversized by its own stroke, that `.sticker__face`
     then sits on top of. Only the band between the two stroke widths ever shows. */
  .sticker__rim {
    fill: var(--color-ink);
    stroke: var(--color-ink);
    stroke-width: 0.16em;
    stroke-linejoin: round;
    paint-order: stroke fill;
  }

  /* The sticker body: paper-coloured ring, ink letters — this is what leaves the rim
     visible as a thin dark edge outside it. */
  .sticker__face {
    fill: var(--color-ink);
    stroke: var(--color-paper);
    stroke-width: 0.1em;
    stroke-linejoin: round;
    paint-order: stroke fill;
  }

  .sticker__glow {
    fill: var(--color-signal);
  }

  @media (prefers-reduced-motion: no-preference) {
    .sticker__band {
      transform-box: view-box;
      animation: sticker-sweep 5.5s var(--ease-in-out) infinite;
    }
  }

  @keyframes sticker-sweep {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(calc(var(--box-width) + var(--sweep-band) * 2));
    }
  }
</style>
