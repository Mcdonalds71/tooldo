---
import { SITE } from '../lib/site';
import { tools } from '../lib/tools';

const year = new Date().getFullYear();
const liveTools = tools.filter((t) => t.status === 'live');
---

<footer class="footer">
  <div class="shell footer__inner">
    <div class="footer__brand-col">
      <a href="/" class="lockup footer__brand">
        <img class="lockup__mark" src="/icon.svg" alt="" width="128" height="128" />
        {SITE.name}
      </a>
      <p class="footer__blurb">{SITE.tagline}. {SITE.promise}</p>

      <div class="footer__badges">
        <span class="footer__badge">
          <span class="footer__badge-dot"></span>
          100% In-Browser
        </span>
        <span class="footer__badge">
          ⚡ Zero Uploads
        </span>
      </div>
    </div>

    <div class="footer__nav-grid">
      <div class="footer__nav-col">
        <p class="footer__nav-title">Tools</p>
        <ul class="footer__nav-list">
          {
            liveTools.map((tool) => (
              <li>
                <a href={`/${tool.slug}`}>{tool.name}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="footer__nav-col">
        <p class="footer__nav-title">Platform</p>
        <ul class="footer__nav-list">
          <li><a href="/#tools">All Tools</a></li>
          <li><a href="/privacy">Privacy Promise</a></li>
          <li><a href="/#different">Why tooldo</a></li>
          <li><a href="/design-system">Design System</a></li>
        </ul>
      </div>

      <div class="footer__nav-col">
        <p class="footer__nav-title">Project</p>
        <ul class="footer__nav-list">
          <li>
            <a href={SITE.repo} target="_blank" rel="noopener noreferrer">Source on GitHub</a>
          </li>
          <li>
            <a href={SITE.author.url} target="_blank" rel="noopener noreferrer">
              Author: {SITE.author.name}
            </a>
          </li>
          <li><span class="footer__nav-meta">MIT Open Source</span></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="shell footer__bottom">
    <p class="footer__copyright">
      &copy; {year} {SITE.name} &middot; Built by{' '}
      <a href={SITE.author.url} target="_blank" rel="noopener noreferrer">{SITE.author.name}</a>{' '}
      for the people of the internet.
    </p>
    <p class="footer__meta">
      No tracking &middot; No accounts &middot; Open source
    </p>
  </div>

  <div class="footer__wordmarkWrap" aria-hidden="true">
    <svg class="footer__wordmarkSvg" viewBox="0 0 1000 145" preserveAspectRatio="none">
      <text
        x="-10"
        y="170"
        textLength="1020"
        lengthAdjust="spacingAndGlyphs"
        class="footer__wordmarkText"
      >
        {SITE.name.toLowerCase()}
      </text>
    </svg>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-top: var(--space-2xl);
    padding-bottom: 0;
    background-color: var(--color-char);
    color: var(--color-line);
  }

  .footer__inner {
    display: grid;
    grid-template-columns: 1.2fr 2fr;
    gap: var(--space-2xl);
    align-items: start;
  }

  .footer__brand-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .footer__brand {
    font-size: var(--text-2xl);
    color: var(--color-paper);
    text-transform: uppercase;
    padding: 0;
    margin: 0;
    line-height: 1;
  }

  .footer__blurb {
    max-width: 36ch;
    margin-top: var(--space-xs);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    color: var(--color-line);
  }

  .footer__badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-top: var(--space-sm);
  }

  .footer__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    border: 1px solid rgba(255, 255, 255, 0.12);
    background-color: var(--color-char-raised, #26231b);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-paper);
  }

  .footer__badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-success);
  }

  .footer__nav-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xl);
  }

  .footer__nav-col {
    display: flex;
    flex-direction: column;
  }

  .footer__nav-title {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--color-paper);
    margin: 0 0 var(--space-sm);
    line-height: 1;
    padding-top: 0.25rem;
  }

  .footer__nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    font-size: var(--text-sm);
  }

  .footer__nav-list a {
    color: var(--color-line);
    text-decoration: none;
    transition: color var(--dur-fast, 0.15s) ease;
  }

  .footer__nav-list a:hover {
    color: var(--color-paper);
  }

  /* `--color-ink-faint` is tuned to clear AA against paper, so on this charcoal panel
     it runs the wrong way: darkening faint text only helps on a light surface. Against
     `--color-char` it lands at 3.23:1, under the 4.5:1 small text needs. The line tone
     is what the rest of this footer already uses on the same background. */
  .footer__nav-meta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-line);
  }

  .footer__bottom {
    margin-top: var(--space-2xl);
    padding-top: var(--space-md);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    /* Same inverse-surface reason as `.footer__nav-meta` above — `.footer__copyright`
       and `.footer__meta` both inherit their colour from here. */
    color: var(--color-line);
  }

  .footer__copyright a {
    color: var(--color-line);
    text-decoration: none;
  }

  .footer__copyright a:hover {
    color: var(--color-paper);
  }

  .footer__meta {
    letter-spacing: 0.02em;
  }

  .footer__wordmarkWrap {
    position: relative;
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    overflow: hidden;
    display: flex;
    justify-content: center;
    pointer-events: none;
    margin-top: var(--space-xl);
    margin-bottom: 0;
    line-height: 0;
    font-size: 0;
  }

  .footer__wordmarkSvg {
    width: 100%;
    height: auto;
    max-height: 15vw;
    display: block;
    vertical-align: bottom;
    margin-bottom: 0;
  }

  .footer__wordmarkText {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    letter-spacing: -0.045em;
    text-transform: lowercase;
    fill: rgba(255, 255, 255, 0.045);
    font-size: 260px;
    user-select: none;
  }

  @media (width < 56rem) {
    .footer {
      padding-top: var(--space-xl);
      padding-bottom: 0;
    }

    .footer__inner {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }

    .footer__nav-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-lg);
    }

    .footer__bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2xs);
    }
  }
</style>
