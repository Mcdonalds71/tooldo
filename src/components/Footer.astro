---
import { SITE } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="shell footer__inner">
    <div>
      <span class="lockup footer__brand">
        <img class="lockup__mark" src="/icon.svg" alt="" width="128" height="128" />
        {SITE.name}
      </span>
      <p class="footer__blurb">{SITE.tagline}. {SITE.promise}</p>
    </div>

    <nav class="footer__links" aria-label="Footer">
      <a href="/#tools">All tools</a>
      <a href="/privacy">Privacy promise</a>
      <a href={SITE.repo}>Source on GitHub</a>
    </nav>
  </div>

  <div class="shell footer__bottom">
    <p>
      &copy; {year} {SITE.name} &middot; Built by
      <a href={SITE.author.url}>{SITE.author.name}</a> for the people of the internet.
    </p>
  </div>

  {
    /* Pure decoration — the name is already announced by the lockup above, so a screen
       reader has no reason to hit it twice. Sized past anything read as a heading and
       bled off the footer's own bottom edge: `overflow: hidden` on `.footer` is what
       turns "oversized text" into "a wordmark the page cuts off," the same technique
       the closing card's mobile glow uses to bleed off its own edge.

       Two elements, not one: the outer `shell` div is what's positioned and sized (it
       carries the same capped width and gutters every other row in this footer lines
       up against), and the inner `<p>` is what's sized in `cqw` against it. Querying a
       container from the element that IS that container is a circularity CSS can't
       resolve — it falls back to measuring something else, silently, which is how a
       first pass at this rendered at the wrong size on a wide screen despite reading
       correct in every computed-style check. */
  }
  <div class="footer__wordmarkWrap shell">
    <p class="footer__wordmark" aria-hidden="true">{SITE.name}</p>
  </div>
</footer>

<style>
  /* The charcoal footer is an inverse surface: the ink scale is tuned for paper and
     goes muddy here, so muted text steps up to the line tone instead.

     No margin-top of its own: the closing card immediately above this sets its own
     padding-bottom precisely so this gap matches every other section transition on
     the page (the same value the divider system uses between story sections). A
     margin here on top of that padding was two numbers doing one job, and the two
     summed to a gap roughly twice the size of any other on the page. */
  /* The top value is the other half of the seam with `.closing__card` above, which
     sits flush against this with no paper between them — both sides of that join use
     the same token deliberately, so the closing block's breathing room reads as
     symmetrical rather than as one surface crowding the other. */
  .footer {
    position: relative;
    /* Without this, `.footer` never becomes a stacking context of its own — plain
       `position: relative` doesn't create one on its own — so the wordmark's negative
       `z-index` below escapes to the page's root context instead of staying scoped
       here, and ends up painted behind this element's own background rather than
       behind its content. Invisible, not merely dim. */
    isolation: isolate;
    overflow: hidden;
    padding-block: var(--space-2xl) var(--space-3xl);
    background-color: var(--color-char);
    color: var(--color-line);
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-lg);
  }

  .footer__brand {
    font-size: var(--text-xl);
    color: var(--color-paper);
    text-transform: uppercase;
    margin-inline-start: -0.5em;
  }

  .footer__blurb {
    max-width: 32ch;
    margin-top: var(--space-3xs);
    font-size: var(--text-sm);
    color: var(--color-line);
  }

  .footer__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    font-size: var(--text-sm);
  }

  .footer__links a,
  .footer__bottom a {
    color: var(--color-line);
    text-decoration: none;
  }

  .footer__links a:hover,
  .footer__bottom a:hover {
    color: var(--color-paper);
  }

  .footer__bottom {
    margin-top: var(--space-2xl);
    padding-top: var(--space-md);
    border-top: 1px solid color-mix(in srgb, var(--color-paper) 8%, transparent);
    font-size: var(--text-sm);
    color: var(--color-line);
  }

  /* Pinned to the footer's own bottom edge, independent of `padding-block-end` —
     tying the bleed to that padding would mean shrinking it to make room, and it's
     shared with nothing here to shrink against. Negative `z-index` keeps it under the
     real content on the off chance the two ever overlap — the colour below is faint
     enough that it barely matters, but it costs nothing to be sure.

     `container-type` lives here, not on the text itself: this is the box with a real,
     content-independent width (`.shell`'s `max-width`, same as every other row in the
     footer), so it's what `cqw` on the text below should measure against. */
  .footer__wordmarkWrap {
    container-type: inline-size;
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: -1;
  }

  /* Sized in `cqw` off the wrapper's own box rather than `vw`: a viewport unit keeps
     growing past `.shell`'s `max-width`, while the box this is meant to fill has
     already stopped — exactly what left it reading small and short of the edges on a
     wide monitor. `cqw` tracks the wrapper's actual rendered width at every size
     instead. Pushed down a third of its own line height, after sizing, so the glyphs
     bleed past the footer's edge rather than sitting inside it — `overflow: hidden`
     on `.footer` is what turns that overflow into a clean cut, not a scrollbar. */
  .footer__wordmark {
    translate: 0 38%;
    font-family: var(--font-display);
    font-size: 23.1cqw;
    font-weight: var(--weight-bold);
    line-height: 0.8;
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    white-space: nowrap;
    color: color-mix(in srgb, var(--color-paper) 7%, transparent);
    user-select: none;
  }

  @media (width < 56rem) {
    .footer {
      padding-block: var(--space-xl) var(--space-2xl);
    }
  }
</style>
