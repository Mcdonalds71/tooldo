---
import { SITE } from '../lib/site';
import FooterSticker from './FooterSticker.astro';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="shell footer__inner">
    <div>
      <span class="lockup footer__brand">
        <img class="lockup__mark" src="/icon.svg" alt="" width="128" height="128" />
        {SITE.name}
      </span>
      <p class="footer__blurb">{SITE.tagline}. {SITE.promise}</p>
    </div>

    <nav class="footer__links" aria-label="Footer">
      <a href="/#tools">All tools</a>
      <a href="/privacy">Privacy promise</a>
      <a href={SITE.repo}>Source on GitHub</a>
    </nav>
  </div>

  <div class="shell footer__bottom">
    <p>
      &copy; {year} {SITE.name} &middot; Built by
      <a href={SITE.author.url}>{SITE.author.name}</a> for the people of the internet.
    </p>
  </div>

  <FooterSticker />
</footer>

<style>
  /* The charcoal footer is an inverse surface: the ink scale is tuned for paper and
     goes muddy here, so muted text steps up to the line tone instead.

     No bottom padding — the sticker is the last thing on the page and sits flush on
     the bottom edge, so what's under it is its own tight viewBox and nothing else. */
  .footer {
    margin-top: var(--space-4xl);
    padding-top: var(--space-3xl);
    background-color: var(--color-char);
    color: var(--color-line);
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-lg);
  }

  .footer__brand {
    font-size: var(--text-xl);
    color: var(--color-paper);
    margin-inline-start: -0.5em;
  }

  .footer__blurb {
    max-width: 32ch;
    margin-top: var(--space-3xs);
    font-size: var(--text-sm);
    color: var(--color-line);
  }

  .footer__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    font-size: var(--text-sm);
  }

  .footer__links a,
  .footer__bottom a {
    color: var(--color-line);
    text-decoration: none;
  }

  .footer__links a:hover,
  .footer__bottom a:hover {
    color: var(--color-paper);
  }

  .footer__bottom {
    margin-top: var(--space-2xl);
    padding-top: var(--space-md);
    border-top: 1px solid color-mix(in srgb, var(--color-paper) 8%, transparent);
    font-size: var(--text-sm);
    color: var(--color-line);
  }
</style>
