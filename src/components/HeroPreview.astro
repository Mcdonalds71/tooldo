---
import { HeroAnimation } from './HeroAnimation';
---

<div class="preview-wrapper">
  <article class="preview">
    <div class="preview__inner">
      <HeroAnimation client:load />
    </div>
  </article>
</div>

<style>
  .preview-wrapper {
    position: relative;
    width: 100%;
    filter: drop-shadow(6px 6px 0 var(--color-ink, #1c1a15));
    --hero-chamfer-tr: clamp(2.5rem, 6vw, 4.5rem);
    --hero-chamfer-bl: clamp(2rem, 5vw, 3.5rem);
  }

  .preview {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    min-height: 18rem;
    background-color: var(--color-ink, #1c1a15);
    padding: 2.5px;
    clip-path: polygon(
      0 14px,
      14px 0,
      calc(100% - var(--hero-chamfer-tr)) 0,
      100% var(--hero-chamfer-tr),
      100% calc(100% - 14px),
      calc(100% - 14px) 100%,
      var(--hero-chamfer-bl) 100%,
      0 calc(100% - var(--hero-chamfer-bl))
    );
    display: flex;
  }

  .preview__inner {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background-color: var(--color-card);
    clip-path: polygon(
      0 14px,
      14px 0,
      calc(100% - var(--hero-chamfer-tr)) 0,
      100% var(--hero-chamfer-tr),
      100% calc(100% - 14px),
      calc(100% - 14px) 100%,
      var(--hero-chamfer-bl) 100%,
      0 calc(100% - var(--hero-chamfer-bl))
    );
  }

  @media (width < 56rem) {
    .preview-wrapper {
      filter: drop-shadow(4px 4px 0 var(--color-ink, #1c1a15));
    }

    .preview {
      aspect-ratio: 16 / 9;
      min-height: 12rem;
      padding: 2px;
    }
  }
</style>
