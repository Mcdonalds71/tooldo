---
import { formatBytes } from '../lib/formatBytes';

/**
 * The frame a tool animation will live in. Until the tools exist it holds the one
 * thing the compressor is actually for — the before and after — over a warm wash, so
 * it reads as a held space rather than a missing asset.
 */

const before = 2_400_000;
const after = 340_000;
const saved = Math.round((1 - after / before) * 100);
---

<article class="preview">
  <p class="preview__label">Image compressor</p>

  <div class="preview__stat">
    <span class="preview__leg">
      <span class="preview__caption">before</span>
      <b>{formatBytes(before)}</b>
    </span>

    <span class="preview__arrow" aria-hidden>&rarr;</span>

    <span class="preview__leg">
      <span class="preview__caption">after</span>
      <b>{formatBytes(after)}</b>
    </span>

    <span class="preview__saved" data-saved={saved}>&minus;{saved}%</span>
  </div>

  <!-- The tool's own animation mounts here once that tool is built. -->
  <div class="preview__stage" data-slot="animation"></div>
</article>

<style>
  .preview {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding: var(--space-md);
    border: var(--card-border);
    border-radius: var(--bento-radius);
    box-shadow: var(--card-shadow);
    background-color: var(--color-card);
    background-image: linear-gradient(
      160deg,
      color-mix(in srgb, var(--color-signal) 16%, transparent),
      color-mix(in srgb, var(--color-signal) 4%, transparent) 55%,
      transparent
    );
  }

  .preview__label {
    align-self: flex-start;
    padding: var(--space-3xs) var(--space-xs);
    border-radius: var(--radius-full);
    background-color: var(--color-paper-dim);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }

  .preview__stat {
    display: flex;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .preview__caption {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-ink-faint);
  }

  .preview__leg b {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-tight);
  }

  .preview__arrow {
    padding-bottom: var(--space-3xs);
    font-size: var(--text-lg);
    color: var(--color-signal-dark);
  }

  .preview__saved {
    margin-inline-start: auto;
    padding: var(--space-3xs) var(--space-xs);
    border-radius: var(--radius-full);
    background-color: var(--color-ink);
    color: var(--color-paper);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  /* Sized for the tool loop that will live here, which is what makes this card the
     focus of the hero rather than a caption with a gap under it. */
  .preview__stage {
    flex: 1;
    min-height: 10rem;
    border-radius: var(--radius-md);
    background-color: color-mix(in srgb, var(--color-paper-dim) 55%, transparent);
  }
</style>
