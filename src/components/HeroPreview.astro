---
import { HeroAnimation } from './HeroAnimation';
---

<div class="preview-wrapper">
  <svg width="0" height="0" style="position: absolute;" aria-hidden="true">
    <defs>
      <clipPath id="hero-preview-clip" clipPathUnits="objectBoundingBox">
        <path
          d="
            M 0, 0.04
            Q 0,0 0.025,0
            L 0.88, 0
            Q 0.905,0 0.92,0.025
            L 0.98,0.12
            Q 1,0.15 1,0.18
            L 1, 0.96
            Q 1,1 0.975,1
            L 0.12, 1
            Q 0.095,1 0.08,0.975
            L 0.02,0.88
            Q 0,0.85 0,0.82
            Z
          "
        ></path>
      </clipPath>
    </defs>
  </svg>

  <article class="preview">
    <div class="preview__inner">
      <HeroAnimation client:load />
    </div>
  </article>
</div>

<style>
  .preview-wrapper {
    position: relative;
    width: 100%;
    filter: drop-shadow(6px 6px 0 var(--color-ink, #1c1a15));
  }

  .preview {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    min-height: 18rem;
    background-color: var(--color-ink, #1c1a15);
    padding: 2.5px;
    clip-path: url(#hero-preview-clip);
    display: flex;
  }

  .preview__inner {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background-color: var(--color-card);
    clip-path: url(#hero-preview-clip);
  }

  @media (width < 56rem) {
    .preview-wrapper {
      width: calc(100% - 4px);
      filter: drop-shadow(4px 4px 0 var(--color-ink, #1c1a15));
    }

    .preview {
      aspect-ratio: 16 / 10;
      min-height: 14rem;
      padding: 2px;
    }
  }
</style>
