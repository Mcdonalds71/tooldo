---
import { HeroAnimation } from './HeroAnimation';
---

<div class="preview-wrapper">
  <svg width="0" height="0" style="position: absolute;" aria-hidden="true">
    <defs>
      <clipPath id="hero-preview-clip" clipPathUnits="objectBoundingBox">
        <path
          d="
            M 0, 0.03
            Q 0,0 0.015,0
            L 0.94, 0
            Q 0.955,0 0.965,0.015
            L 0.99,0.065
            Q 1,0.08 1,0.095
            L 1, 0.97
            Q 1,1 0.985,1
            L 0.06, 1
            Q 0.045,1 0.035,0.985
            L 0.01,0.935
            Q 0,0.92 0,0.905
            Z
          "
        ></path>
      </clipPath>
    </defs>
  </svg>

  <article class="preview" transition:persist="hero-preview">
    <div class="preview__inner">
      <HeroAnimation client:load />
    </div>
  </article>
</div>

<style>
  .preview-wrapper {
    position: relative;
    width: 100%;
    filter: drop-shadow(4px 4px 0 var(--color-ink, #1c1a15));
  }

  .preview {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    min-height: 18rem;
    background-color: var(--color-ink, #1c1a15);
    padding: 2.5px;
    clip-path: url(#hero-preview-clip);
    display: flex;
  }

  .preview__inner {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background-color: var(--color-card);
    clip-path: url(#hero-preview-clip);
  }

  @media (width < 56rem) {
    .preview-wrapper {
      filter: drop-shadow(3px 3px 0 var(--color-ink, #1c1a15));
    }

    .preview {
      aspect-ratio: 16 / 10;
      min-height: 13.5rem;
      padding: 2px;
    }
  }
</style>
