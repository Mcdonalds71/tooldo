---
import { HeroAnimation } from './HeroAnimation';
---

<div class="preview-wrapper">
  <svg width="0" height="0" style="position: absolute;" aria-hidden="true">
    <defs>
      <clipPath id="hero-preview-clip" clipPathUnits="objectBoundingBox">
        <path
          d="
            M 0, 0.03
            Q 0,0 0.018,0
            L 0.90, 0
            Q 0.92,0 0.935,0.025
            L 0.985,0.115
            Q 1,0.14 1,0.17
            L 1, 0.97
            Q 1,1 0.982,1
            L 0.095, 1
            Q 0.075,1 0.06,0.975
            L 0.012,0.89
            Q 0,0.865 0,0.835
            Z
          "
        ></path>
      </clipPath>
    </defs>
  </svg>

  <article class="preview">
    <div class="preview__inner">
      <HeroAnimation client:load />
    </div>
  </article>
</div>

<style>
  .preview-wrapper {
    position: relative;
    width: 100%;
    max-width: 100%;
    filter: drop-shadow(6px 6px 0 var(--color-ink, #1c1a15));
  }

  .preview {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    min-height: 18rem;
    background-color: var(--color-ink, #1c1a15);
    padding: 2.5px;
    clip-path: url(#hero-preview-clip);
    display: flex;
  }

  .preview__inner {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background-color: var(--color-card);
    clip-path: url(#hero-preview-clip);
  }

  @media (width < 56rem) {
    .preview-wrapper {
      filter: drop-shadow(4px 4px 0 var(--color-ink, #1c1a15));
    }

    .preview {
      aspect-ratio: 16 / 10.5;
      min-height: 15rem;
      padding: 2px;
    }
  }
</style>
