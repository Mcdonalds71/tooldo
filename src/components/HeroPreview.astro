---
import { HeroAnimation } from './HeroAnimation';
---

<article class="preview">
  <HeroAnimation client:load />
</article>

<style>
  .preview {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    min-height: 18rem;
    overflow: hidden;
    border: var(--card-border);
    border-radius: var(--bento-radius);
    box-shadow: var(--card-shadow);
    background-color: var(--color-card);
    display: flex;
  }

  @media (width < 56rem) {
    .preview {
      aspect-ratio: 16 / 9;
      min-height: 12rem;
    }
  }
</style>
