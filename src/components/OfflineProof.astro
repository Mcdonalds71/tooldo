---
import { CheckIcon, HardDrivesIcon } from '@phosphor-icons/react/dist/ssr';

/**
 * The page's second and last big motion beat (the hero owns the first), and the only
 * one that argues rather than decorates: the cable to the server is pulled as you
 * scroll, and the work carries on finishing in front of you.
 *
 * It earns the scroll because it is the product's actual claim rather than an effect —
 * there is no server in this architecture, so severing the line changes nothing, and
 * that is the whole point being made. ADR 0017 made it literally true; this shows it.
 *
 * The resting state in CSS is the *finished* state — disconnected, stamped, complete.
 * Reduced motion and a JS failure both land there rather than on a half-told story,
 * which is why the timeline below sets the "connected" start rather than the end.
 */
---

<section class="proof">
  <div class="proof__pin">
    <div class="shell">
      <p class="eyebrow">the proof</p>
      <h2 class="proof__heading">Cut the cord. It keeps working.</h2>

      <div class="proof__stage">
        <div class="proof__device">
          <div class="proof__bar" aria-hidden="true">
            <span class="proof__dot"></span>
            <span class="proof__dot"></span>
            <span class="proof__dot"></span>
          </div>
          <div class="proof__screen">
            <div class="proof__filerow">
              <p class="proof__file">holiday-photos.zip</p>
              {/* The finished value, like every other resting state in this file: the
                  bar is full and the done line is showing in plain CSS, so the number
                  beside them has to agree. The timeline sets it back to 18% at the
                  start of the scrub and counts it up from there — and on mobile, where
                  the scrub never runs at all, this is the only value ever shown. */}
              <span class="proof__percent" aria-hidden="true">100%</span>
            </div>
            <div class="proof__track" aria-hidden="true">
              <span class="proof__fill"></span>
            </div>
            <p class="proof__done">
              <CheckIcon size="1em" weight="bold" aria-hidden />
              Done — never left your device
            </p>
          </div>
        </div>

        <div class="proof__link" aria-hidden="true">
          <span class="proof__wire"></span>
          <span class="proof__pulse"></span>
        </div>

        <div class="proof__server" aria-hidden="true">
          <HardDrivesIcon size="2.5rem" weight="duotone" />
          <span class="proof__serverLabel">server</span>
        </div>

        <p class="proof__stamp" aria-hidden="true">offline</p>
      </div>
    </div>
  </div>
</section>

<style>
  /* No min-height: this section is exactly as tall as its content, like every other
     one. It previously stood at 82svh with its content centred, which parked the
     artwork in the middle of a near-empty screen — the gap a reader actually saw
     either side of it ran to hundreds of pixels while the section *box* sat the same
     64px from its dividers as everywhere else. Measuring boxes said the spacing was
     even; looking at the page said otherwise, and the page was right. */
  .proof__pin {
    display: grid;
  }

  .proof__heading {
    margin-top: var(--space-xs);
    font-size: var(--text-3xl);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
  }

  .proof__stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(3rem, 0.6fr) auto;
    align-items: center;
    margin-top: var(--space-xl);
  }

  .proof__device {
    border: var(--brut-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-brut-lifted);
    background-color: var(--color-card);
    overflow: hidden;
  }

  .proof__bar {
    display: flex;
    gap: var(--space-3xs);
    padding: var(--space-2xs) var(--space-sm);
    border-bottom: var(--brut-border);
    background-color: var(--color-paper-dim);
  }

  .proof__dot {
    width: 0.6rem;
    height: 0.6rem;
    border: 1.5px solid var(--color-ink);
    border-radius: 50%;
  }

  .proof__screen {
    padding: var(--space-lg);
  }

  .proof__filerow {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .proof__file {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  .proof__percent {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    font-variant-numeric: tabular-nums;
    color: var(--color-signal-dark);
  }

  .proof__track {
    height: 0.9rem;
    margin-top: var(--space-2xs);
    overflow: hidden;
    border: var(--brut-border);
    border-radius: var(--radius-full);
    background-color: var(--color-paper);
  }

  /* Scaled, never widthed — a width tween is a layout tween, and this one runs while
     the page is pinned and scrubbing, which is the worst possible place to drop frames. */
  .proof__fill {
    display: block;
    height: 100%;
    transform-origin: left center;
    border-radius: inherit;
    background-color: var(--color-signal-fill);
  }

  .proof__done {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
    margin-top: var(--space-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-signal-dark);
  }

  .proof__link {
    position: relative;
    display: grid;
    place-items: center;
    height: 0.5rem;
  }

  .proof__wire {
    width: 100%;
    height: 0.35rem;
    /* Retracted at rest — the CSS default has to be the disconnected end of the
       story, per this file's own doc comment, or reduced motion and no-JS would
       show a wire that's still plugged in. The timeline's `.from()` below is what
       makes it look connected at the top of the scrub and pull free by the middle. */
    transform: scaleX(0);
    /* Origin at the device end, so retracting reads as the plug being pulled out of
       the server rather than the cable shrinking from both ends at once. */
    transform-origin: left center;
    border-radius: var(--radius-full);
    background-color: var(--color-ink);
  }

  .proof__pulse {
    position: absolute;
    left: 0;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background-color: var(--color-signal);
    opacity: 0;
  }

  .proof__server {
    position: relative;
    display: grid;
    place-items: center;
    gap: var(--space-3xs);
    padding: var(--space-md);
    border: var(--brut-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--card-shadow);
    background-color: var(--color-card);
    color: var(--color-ink-faint);
  }

  /* A quiet idle tell, independent of scroll — the section has some life to it even
     before anyone starts scrubbing through the beats below. */
  .proof__server::before {
    content: '';
    position: absolute;
    inset: -0.4rem;
    border: 1.5px solid var(--color-line);
    border-radius: inherit;
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .proof__server::before {
      animation: proof-pulse-ring 2.6s var(--ease-out) infinite;
    }
  }

  @keyframes proof-pulse-ring {
    from {
      opacity: 0.6;
      scale: 1;
    }

    to {
      opacity: 0;
      scale: 1.35;
    }
  }

  .proof__serverLabel {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
  }

  /* The sticker language from the footer, reused at the one other place on the page
     that wants to shout — set on the diagonal so it reads as stamped, not placed. */
  .proof__stamp {
    position: absolute;
    top: 50%;
    right: 6%;
    padding: var(--space-2xs) var(--space-md);
    border: var(--brut-border);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-brut);
    background-color: var(--color-signal-fill);
    color: var(--color-on-signal);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    rotate: -8deg;
    translate: 0 -50%;
  }

  @media (width < 56rem) {
    .proof__pin {
      min-height: auto;
    }

    /* The cable is a horizontal idea, and with nothing to span it goes — and the
       server goes with it, because a lone box labelled "server" with no line running
       to it isn't context, it's a mystery. What's left is the thing the section is
       actually about: the file finishing, with the stamp landing across the corner of
       it the way a stamp lands on paper. */
    .proof__stage {
      grid-template-columns: 1fr;
      justify-items: center;
    }

    .proof__link,
    .proof__server {
      display: none;
    }

    /* Sat across the lower corner of the card rather than hanging off its edge. The
       stamp is rotated, and a rotated box's *bounding* box is taller than its layout
       box — roughly 11px here — so anything that puts its edge near the section's
       edge overruns the boundary and eats into the gap below it. Keeping it well
       inside the card means the card's own bottom stays the section's bottom, and the
       gap to the divider is the same as every other section's. */
    .proof__stamp {
      top: auto;
      right: var(--space-md);
      bottom: var(--space-lg);
      translate: 0;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  /**
   * The CSS resting state is the end of the story, so this sets the beginning and plays
   * forward. Anyone with reduced motion, or no JS, gets the finished frame — the claim
   * still lands, it just doesn't perform.
   */
  /* The width half matches the breakpoint where the stage turns horizontal and the
     cable appears at all. Below it there is no cord on screen to cut, so pinning the
     viewport to tell that story would cost a phone a screen of scrolling for nothing. */
  gsap.matchMedia().add('(prefers-reduced-motion: no-preference) and (width >= 56rem)', () => {
    const stage = document.querySelector('.proof__stage');
    const percentEl = document.querySelector('.proof__percent');
    if (!stage) return;

    /* A plain tween target rather than the DOM: GSAP can animate a number smoothly
       through a scrub, but there's no CSS property to scrub text through, so the
       number lives on this object and onUpdate writes it to the element by hand. */
    const counter = { value: 18 };

    const timeline = gsap.timeline({
      scrollTrigger: {
        trigger: '.proof',
        /* Not pinned, deliberately. Pinning buys a viewport-hijacking moment at the
           cost of a `pin-spacer` — an element as tall as the pin's whole scroll
           range, inserted into the document. The pinned content sits at the top of
           that spacer, so once the pin lets go there is a spacer-sized hole between
           this section's artwork and whatever follows it: measured at 1360px here,
           against the 64px every other section boundary uses. No arrangement of
           `start`/`end` removes that hole, because the spacer *is* the scroll
           distance the scrub needs.

           Scrubbing across the section's own pass through the viewport instead costs
           nothing in layout: the section stays exactly as tall as its content, the
           gaps either side stay the shared 64px, and the beats still play under the
           reader's thumb rather than on a timer. */
        start: 'top bottom',
        end: 'bottom top',
        scrub: 0.6,
      },
    });

    timeline
      // Beat one, 0 -> 0.4: the file finishes copying. Bar and counter move together
      // since they're reporting the same number two ways.
      .from('.proof__fill', { scaleX: 0.18, ease: 'none', duration: 0.4 }, 0)
      .to(
        counter,
        {
          value: 100,
          ease: 'none',
          duration: 0.4,
          onUpdate: () => {
            if (percentEl) percentEl.textContent = `${Math.round(counter.value)}%`;
          },
        },
        0,
      )
      .from('.proof__done', { opacity: 0, y: 8, ease: 'none', duration: 0.1 }, 0.32)
      .fromTo('.proof__pulse', { opacity: 1, x: 0 }, { x: '100%', ease: 'none', duration: 0.42 }, 0)

      // Beat two, 0.42 -> 0.64: the pull. The turn in the story, so it gets its own
      // clear stretch of scroll rather than overlapping the first beat.
      .to('.proof__pulse', { opacity: 0, duration: 0.06 }, 0.42)
      .from('.proof__wire', { scaleX: 1, ease: 'power2.in', duration: 0.22 }, 0.42)
      .to('.proof__server', { opacity: 0.25, x: 24, ease: 'power2.in', duration: 0.22 }, 0.42)

      // Beat three, 0.64 -> 0.92: the stamp lands with a touch of overshoot — a scrub
      // still honours an eased tween's own internal curve as you cross its range, it
      // just isn't driven by a clock while doing it.
      .from(
        '.proof__stamp',
        { opacity: 0, scale: 2, rotate: 10, ease: 'back.out(1.7)', duration: 0.28 },
        0.64,
      );

    return () => timeline.kill();
  });
</script>
