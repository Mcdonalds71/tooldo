---
import HeroBadge from './HeroBadge.astro';
import HeroPreview from './HeroPreview.astro';
import HeroPromise from './HeroPromise.astro';

/**
 * Editorial: the headline is the whole top of the page, set in caps at display size
 * and ranged left, with the bento carrying the argument underneath.
 *
 * The copy stays sentence case in the markup and is uppercased by CSS, so the voice
 * rules hold and the treatment is typographic rather than baked into the words.
 */
---

<section class="hero">
  <div class="shell">
    <div class="hero__top">
      <h1 class="hero__headline">
        Fix any file.<br />Without the cloud.
      </h1>

      <HeroBadge />
    </div>

    <div class="hero__bento">
      <HeroPreview />
      <HeroPromise />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-lg) var(--space-3xl);
  }

  /* 700 is the top of Clash Display's axis — there is no heavier cut to reach for. */
  .hero__headline {
    font-size: var(--text-hero);
    font-weight: var(--weight-bold);
    line-height: 0.9;
    letter-spacing: -0.035em;
    text-transform: uppercase;
  }

  /* The stamp takes the wedge of paper the ragged headline leaves on the right. */
  .hero__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--space-lg);
  }

  .hero__bento {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }

  @media (width < 64rem) {
    .hero__top {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: var(--space-md);
    }

    /* Full bleed across the column, so the caps set edge to edge. */
    .hero__headline {
      justify-self: stretch;
      font-size: var(--text-hero-narrow);
    }
  }

  @media (width < 56rem) {
    .hero__bento {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import gsap from 'gsap';

  const cards = gsap.utils.toArray<HTMLElement>('.hero__bento > *, .badge');

  // The resting layout is the CSS one, so reduced motion and no-JS both land there.
  gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
    gsap.from(cards, {
      y: 28,
      opacity: 0,
      duration: 0.7,
      ease: 'back.out(1.4)',
      stagger: 0.09,
      delay: 0.15,
    });
  });
</script>
