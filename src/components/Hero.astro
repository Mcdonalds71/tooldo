---
import HeroBadge from './HeroBadge.astro';
import HeroPreview from './HeroPreview.astro';
import HeroPromise from './HeroPromise.astro';

/**
 * Editorial: the headline is the whole top of the page, set in caps at display size
 * and ranged left, with the bento carrying the argument underneath.
 *
 * The copy stays sentence case in the markup and is uppercased by CSS, so the voice
 * rules hold and the treatment is typographic rather than baked into the words.
 */
---

<section class="hero">
  <div class="shell">
    <h1 class="hero__headline">
      Fix any file.<br />Keep it private.
    </h1>

    <div class="hero__bento">
      <HeroPreview />

      <div class="hero__aside">
        <HeroBadge />
        <HeroPromise />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--hero-top) var(--space-2xl);
  }

  /* 700 is the top of Clash Display's axis — there is no heavier cut to reach for. */
  .hero__headline {
    font-size: var(--text-hero);
    font-weight: var(--weight-bold);
    line-height: 0.96;
    letter-spacing: -0.035em;
    text-transform: uppercase;
  }

  /* Both cards land on one baseline. The information card is the shorter of the two,
     so the space falls above it — which is where the stamp comes to rest. */
  .hero__bento {
    display: grid;
    grid-template-columns: 1.9fr 1fr;
    align-items: end;
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  /* The stamp is measured from this box, so its gap to the card is a fixed distance
     rather than whatever happens to be left over. */
  .hero__aside {
    position: relative;
  }

  @media (width < 64rem) {
    /* Full bleed across the column, so the caps set edge to edge. Caps stacked this
       tight need a touch more leading on a phone than they do at display size. */
    .hero__headline {
      font-size: var(--text-hero-narrow);
      line-height: 1.04;
    }
  }

  @media (width < 56rem) {
    .hero__bento {
      grid-template-columns: 1fr;
    }

    /* Dissolving the wrapper promotes the stamp and the card to grid items in their
       own right, which is what lets the stamp reorder above the showcase. */
    .hero__aside {
      display: contents;
    }
  }
</style>

<script>
  import gsap from 'gsap';

  const cards = gsap.utils.toArray<HTMLElement>('.hero__bento > *, .badge');

  // The resting layout is the CSS one, so reduced motion and no-JS both land there.
  gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
    gsap.from(cards, {
      y: 28,
      opacity: 0,
      duration: 0.7,
      ease: 'back.out(1.4)',
      stagger: 0.09,
      delay: 0.15,
    });
  });
</script>
