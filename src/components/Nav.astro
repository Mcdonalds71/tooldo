---
import { CaretDownIcon } from '@phosphor-icons/react/dist/ssr';
import { buttonClass } from '../design-system/components/Button';
import { SITE } from '../lib/site';
import { groupToolsByCategory, popularTools, toolHref } from '../lib/tools';

const groups = groupToolsByCategory();
const popular = popularTools();
---

<header class="nav">
  <div class="nav__bar">
    <a class="lockup nav__logo" href="/">
      <img class="lockup__mark" src="/icon.svg" alt="" width="128" height="128" />
      {SITE.name}
    </a>

    <button type="button" class="nav__trigger" aria-expanded="false" aria-controls="all-tools">
      All tools
      <CaretDownIcon size="0.8em" weight="bold" aria-hidden />
    </button>

    <ul class="nav__popular">
      {
        popular.map((tool) => (
          <li>
            <a href={toolHref(tool)}>{tool.name}</a>
          </li>
        ))
      }
    </ul>

    <a class={`${buttonClass({ variant: 'primary', size: 'sm' })} nav__cta`} href="/#tools">
      Open the tools
    </a>
  </div>

  {/* Outside the bar on purpose: an element with backdrop-filter becomes a backdrop
      root, and anything nested inside it can no longer blur the page behind. */}
  <div class="nav__panel" id="all-tools">
    {
      groups.map((group) => (
        <div class="nav__group">
          <p class="nav__group-name">{group.category}</p>
          <ul>
            {group.tools.map((tool) => (
              <li>
                <a class="nav__tool" href={toolHref(tool)}>
                  <span class="nav__tool-icon" aria-hidden>
                    <tool.icon size="1.15rem" weight="duotone" />
                  </span>
                  <span class="nav__tool-name">{tool.name}</span>
                  {tool.status === 'planned' && <span class="nav__soon">Soon</span>}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</header>

<style>
  /* A floating capsule rather than a full-width bar, so the paper shows all round it. */
  /* Sticky is already a positioned element, so it anchors the flyout too. */
  .nav {
    position: sticky;
    top: var(--nav-float);
    z-index: 60;
    margin-top: var(--nav-float);
    padding-inline: var(--gutter);
  }

  /* One padding value all round, so the mark sits as far from the stroke on the left
     as the button does on the right. */
  .nav__bar {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
    padding: var(--space-2xs);
    border: var(--brut-border);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-brut), var(--glass-sheen);
    background-color: var(--glass-tint);
    background-image: var(--glass-gradient);
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
  }

  /* The capsule's own padding is the clear space here, so the lockup drops its own. */
  .nav__logo {
    font-size: var(--text-base);
    padding: 0;
  }

  /* A hard shadow inside a glass capsule reads as a sticker on a window. The hover
     lift stays, so the button still answers the cursor. */
  .nav__cta,
  .nav__cta:hover,
  .nav__cta:active {
    box-shadow: none;
  }

  .nav__cta:focus-visible {
    box-shadow: var(--btn-shadow-focus);
  }

  .nav__trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    height: var(--btn-height-sm);
    padding-inline: var(--space-xs);
    border: none;
    border-radius: var(--radius-full);
    background-color: transparent;
    color: var(--color-ink-soft);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    cursor: pointer;
    transition:
      background-color var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out);
  }

  .nav__trigger :global(svg) {
    transition: rotate var(--dur-base) var(--ease-out);
  }

  /* The trigger and the flyout are siblings now, so :has on the header is what ties
     the hover states together. */
  .nav:has(.nav__trigger:hover) .nav__trigger,
  .nav:has(.nav__panel:hover) .nav__trigger,
  .nav:has(.nav__trigger:focus-visible) .nav__trigger,
  .nav:has(.nav__panel:focus-within) .nav__trigger {
    background-color: var(--color-paper-dim);
    color: var(--color-ink);
  }

  .nav:has(.nav__trigger:hover) .nav__trigger :global(svg),
  .nav:has(.nav__panel:hover) .nav__trigger :global(svg),
  .nav:has(.nav__trigger:focus-visible) .nav__trigger :global(svg),
  .nav:has(.nav__panel:focus-within) .nav__trigger :global(svg) {
    rotate: 180deg;
  }

  .nav__popular {
    display: flex;
    gap: var(--space-3xs);
    list-style: none;
  }

  .nav__popular a {
    display: inline-flex;
    align-items: center;
    height: var(--btn-height-sm);
    padding-inline: var(--space-xs);
    border-radius: var(--radius-full);
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out);
  }

  .nav__popular a:hover {
    background-color: var(--color-paper-dim);
    color: var(--color-ink);
  }

  /* ---- the flyout ---- */

  .nav__panel {
    position: absolute;
    top: calc(100% + var(--space-2xs));
    left: 50%;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md) var(--space-lg);
    width: 40rem;
    max-width: calc(100vw - var(--gutter) * 2);
    padding: var(--space-md);
    border: var(--brut-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-brut), var(--glass-sheen);
    background-color: var(--glass-tint-strong);
    background-image: var(--glass-gradient);
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
    opacity: 0;
    visibility: hidden;
    translate: -50% -0.5rem;
    transition:
      opacity var(--dur-base) var(--ease-out),
      translate var(--dur-base) var(--ease-out),
      visibility var(--dur-base) var(--ease-out);
  }

  /* Bridges the gap under the trigger so the pointer can cross without it closing. */
  .nav__panel::before {
    content: "";
    position: absolute;
    inset-inline: 0;
    bottom: 100%;
    height: var(--space-2xs);
  }

  .nav:has(.nav__trigger:hover) .nav__panel,
  .nav:has(.nav__panel:hover) .nav__panel,
  .nav:has(.nav__trigger:focus-visible) .nav__panel,
  .nav:has(.nav__panel:focus-within) .nav__panel {
    opacity: 1;
    visibility: visible;
    translate: -50% 0;
  }

  .nav__group-name {
    margin-bottom: var(--space-3xs);
    padding-inline: var(--space-2xs);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }

  .nav__group ul {
    list-style: none;
  }

  .nav__tool {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: var(--space-2xs);
    border-radius: var(--radius-md);
    color: var(--color-ink);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-decoration: none;
    transition:
      background-color var(--dur-base) var(--ease-out),
      translate var(--dur-base) var(--ease-out);
  }

  .nav__tool:hover {
    background-color: var(--color-paper-dim);
    translate: 2px 0;
  }

  .nav__tool-icon {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-sm);
    background-color: var(--color-paper-dim);
    color: var(--color-ink);
    flex-shrink: 0;
    transition:
      background-color var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out);
  }

  .nav__tool:hover .nav__tool-icon {
    background-color: var(--color-signal);
    color: var(--color-ink);
  }

  .nav__tool-name {
    flex: 1;
  }

  .nav__soon {
    margin-inline-start: auto;
    padding: 0 var(--space-2xs);
    border-radius: var(--radius-full);
    background-color: var(--color-paper-dim);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-ink-faint);
  }

  /* The capsule can't hold the links on a phone, and the CTA reaches the same grid. */
  @media (width < 62rem) {
    .nav__popular {
      display: none;
    }
  }

  @media (width < 40rem) {
    .nav__trigger,
    .nav__panel {
      display: none;
    }
  }
</style>

<script>
  // CSS already opens the flyout on hover and focus; this only keeps the announced
  // state honest and gives Escape somewhere to go.
  const nav = document.querySelector<HTMLElement>('.nav');
  const trigger = nav?.querySelector<HTMLButtonElement>('.nav__trigger');
  const panel = nav?.querySelector<HTMLElement>('.nav__panel');

  if (nav && trigger && panel) {
    const announce = (open: boolean) => trigger.setAttribute('aria-expanded', String(open));
    const isOpen = () => trigger.matches(':hover') || panel.matches(':hover, :focus-within');

    for (const part of [trigger, panel]) {
      part.addEventListener('pointerenter', () => announce(true));
      part.addEventListener('pointerleave', () => announce(isOpen()));
      part.addEventListener('focusin', () => announce(true));
    }

    nav.addEventListener('focusout', (event) => {
      if (!nav.contains(event.relatedTarget as Node | null)) announce(false);
    });

    nav.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        announce(false);
        (document.activeElement as HTMLElement | null)?.blur();
      }
    });
  }
</script>
