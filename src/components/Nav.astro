---
import { buttonClass } from '../design-system/components/Button';
import { SITE } from '../lib/site';
---

<header class="nav">
  <div class="shell nav__inner">
    <a class="lockup nav__logo" href="/">
      <img class="lockup__mark" src="/icon.svg" alt="" width="128" height="128" />
      {SITE.name}
    </a>

    <nav class="nav__links" aria-label="Main">
      <a href="/#tools">All tools</a>
      <a href="/privacy">Privacy</a>
    </nav>

    <a class={buttonClass({ variant: 'primary', size: 'sm' })} href="/#tools">Open the tools</a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: color-mix(in srgb, var(--color-paper) 82%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid transparent;
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    height: var(--nav-height);
  }

  /* The clear space is padding on the lockup, so pull the row back by that much to
     keep the mark optically aligned with the gutter. */
  .nav__logo {
    font-size: var(--text-lg);
    margin-inline: -0.5em auto;
  }

  .nav__links {
    display: none;
    gap: var(--space-2xs);
  }

  .nav__links a {
    padding: var(--space-2xs) var(--space-xs);
    border-radius: var(--radius-sm);
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-decoration: none;
    transition: background-color var(--dur-base) var(--ease-out);
  }

  .nav__links a:hover {
    background-color: var(--color-paper-dim);
    color: var(--color-ink);
  }

  @media (width >= 40rem) {
    .nav__links {
      display: flex;
    }
  }
</style>
