---
import type { Tool } from '../lib/tools';

export type ToolCardSize = 'lg' | 'md' | 'sm';

interface Props {
  tool: Tool;
  size?: ToolCardSize;
  watermark?: boolean;
}

const { tool, size = 'sm', watermark } = Astro.props;
const { icon: Glyph, status } = tool;
const isLive = status === 'live';
const Wrapper = isLive ? 'a' : 'div';
/** Defaults to the two tall cards, but a caller can opt a wide `sm` card in too
 *  (PDF Toolbox: short but six columns wide, so it has the same kind of spare
 *  room a tall card has, just running sideways instead of underneath). */
const hasWatermark = watermark ?? (size === 'lg' || size === 'md');
---

<Wrapper
  class="card"
  id={`tool-${tool.slug}`}
  href={isLive ? `/${tool.slug}` : undefined}
  data-status={status}
  data-size={size}
>
  {
    /* Only the two cards tall enough to leave real space above a bottom-anchored
       block get one — a single-row card has nothing worth covering. Same glyph as
       the real icon, just huge and faint, so it reads as texture rather than a
       second, competing icon. */
    hasWatermark && (
      <span class="card__watermark" aria-hidden="true">
        <Glyph size="100%" weight="duotone" />
      </span>
    )
  }
  <span class="card__icon">
    <Glyph size="var(--tool-icon-glyph)" weight="duotone" aria-hidden />
  </span>
  <div class="card__text">
    <h3 class="card__name">{tool.name}</h3>
    <p class="card__description">{tool.description}</p>
  </div>
  {!isLive && <span class="card__status">Soon</span>}
</Wrapper>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    /* Bottom-left for every size, not just the feature card — consistency is the
       point. On a card exactly as tall as its own content this is a no-op; on the
       two the bento hands real spare height, it's what keeps the icon and text from
       reading as stuck to the top of a box someone stretched. */
    justify-content: flex-end;
    height: 100%;
    padding: var(--space-md);
    overflow: hidden;
    border: var(--card-border);
    border-radius: var(--card-radius);
    box-shadow: var(--card-shadow);
    background-color: var(--color-card);
    color: inherit;
    text-decoration: none;
    transition:
      transform var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }

  a.card:hover,
  a.card:focus-visible {
    transform: translate(var(--card-lift), var(--card-lift));
    box-shadow: var(--card-shadow-hover);
  }

  /*
   * Dead centre by default, which is also the mobile treatment: `--watermark-size`
   * had never actually been given a value at this width (only inside the desktop
   * media query below), so the glyph's `size` prop was resolving against an unset
   * custom property this whole time rather than rendering at any deliberate size.
   * Desktop overrides both the size (per tier, already set below) and the position
   * back to the top-right corner bleed.
   */
  .card__watermark {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    width: var(--watermark-size);
    height: var(--watermark-size);
    color: var(--color-ink);
    opacity: 0.22;
    pointer-events: none;
    --watermark-size: 7rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      transform var(--dur-slow) var(--ease-out),
      opacity var(--dur-base) var(--ease-out);
    will-change: transform, opacity;
  }

  .card__watermark :global(svg) {
    width: 100% !important;
    height: 100% !important;
    display: block;
  }

  a.card:hover .card__watermark {
    transform: scale(1.04);
    opacity: 0.32;
  }

  .card__icon {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: var(--tool-icon-size);
    height: var(--tool-icon-size);
    margin-bottom: var(--space-sm);
    border-radius: var(--radius-sm);
    background-color: var(--color-paper-dim);
    color: var(--color-ink);
    transition:
      background-color var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out),
      rotate var(--dur-base) var(--ease-out);
  }

  /* The bento hands this card varied widths, and a flex child holding text refuses to
     shrink below its own natural width by default — without this, a long tool name in
     a narrow column pushes the card wider than the grid cell it's been placed in. */
  .card__text {
    position: relative;
    min-width: 0;
  }

  a.card:hover .card__icon {
    background-color: var(--color-signal-fill);
    color: var(--color-on-signal);
    rotate: -6deg;
  }

  .card__name {
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
  }

  .card__description {
    margin-top: var(--space-3xs);
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  .card__status {
    position: absolute;
    top: var(--space-md);
    right: var(--space-md);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }

  /* Bento sizing is desktop-only (the grid itself only spans cards from this width
     up, in index.astro) — below it every card renders identically regardless of the
     size it's been assigned, which is the "mobile view stays normal" promise. Shadow
     weight, the watermark and the feature card's colour all follow the same gate:
     mobile is the plain card throughout, no exceptions. */
  @media (width >= 64rem) {
    .card[data-size='sm'] {
      --watermark-size: 9.5rem;
    }

    .card[data-size='sm'] .card__watermark {
      top: 50%;
      right: 1.5rem;
      transform: translateY(-50%);
    }

    .card[data-size='sm']:has(.card__watermark) {
      background-image: radial-gradient(
        ellipse at 85% 50%,
        color-mix(in srgb, var(--color-ink) 6%, transparent) 0%,
        transparent 65%
      );
    }

    .card[data-size='md'] {
      --tool-icon-size: 58px;
      --tool-icon-glyph: 1.75rem;
      --watermark-size: 15rem;
      padding: var(--space-lg);
      box-shadow: var(--shadow-brut);
      background-image: radial-gradient(
        ellipse at 80% 30%,
        color-mix(in srgb, var(--color-ink) 6%, transparent) 0%,
        transparent 70%
      );
    }

    .card[data-size='md'] .card__watermark {
      top: 1rem;
      right: 1rem;
    }

    .card[data-size='md'] .card__name {
      font-size: var(--text-xl);
    }

    .card[data-size='lg'] {
      --tool-icon-size: 76px;
      --tool-icon-glyph: 2.5rem;
      --watermark-size: 19rem;
      padding: var(--space-lg);
      box-shadow: var(--shadow-brut-lifted);
      background-image: radial-gradient(
        ellipse at 78% 35%,
        color-mix(in srgb, var(--color-signal) 8%, transparent) 0%,
        color-mix(in srgb, var(--color-ink) 5%, transparent) 45%,
        transparent 75%
      );
    }

    .card[data-size='lg'] .card__watermark {
      top: 1rem;
      right: 1rem;
    }

    .card[data-size='lg'] .card__name {
      font-size: var(--text-2xl);
    }

    .card[data-size='lg'] .card__description {
      max-width: 34ch;
      margin-top: var(--space-2xs);
      font-size: var(--text-lg);
    }

    /* The one place the hot accent appears outside a control — the feature card is
       the suite's single "primary" moment on this page, the same way a view gets one
       vermilion button and no more. */
    .card[data-size='lg'] .card__icon {
      background-color: var(--color-signal-fill);
      color: var(--color-on-signal);
    }
  }
</style>
