---
import type { Tool } from '../lib/tools';

export type ToolCardSize = 'lg' | 'md' | 'sm';

interface Props {
  tool: Tool;
  size?: ToolCardSize;
}

const { tool, size = 'sm' } = Astro.props;
const { icon: Glyph, status } = tool;
const isLive = status === 'live';
const Wrapper = isLive ? 'a' : 'div';
---

<Wrapper
  class="card"
  id={`tool-${tool.slug}`}
  href={isLive ? `/${tool.slug}` : undefined}
  data-status={status}
  data-size={size}
>
  <span class="card__icon">
    <Glyph size="var(--tool-icon-glyph)" weight="duotone" aria-hidden />
  </span>
  <div class="card__text">
    <h3 class="card__name">{tool.name}</h3>
    <p class="card__description">{tool.description}</p>
  </div>
  {!isLive && <span class="card__status">Soon</span>}
</Wrapper>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--space-md);
    border: var(--card-border);
    border-radius: var(--card-radius);
    box-shadow: var(--card-shadow);
    background-color: var(--color-card);
    color: inherit;
    text-decoration: none;
    transition:
      transform var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }

  a.card:hover,
  a.card:focus-visible {
    transform: translate(var(--card-lift), var(--card-lift));
    box-shadow: var(--card-shadow-hover);
  }

  .card__icon {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: var(--tool-icon-size);
    height: var(--tool-icon-size);
    margin-bottom: var(--space-sm);
    border-radius: var(--radius-sm);
    background-color: var(--color-paper-dim);
    color: var(--color-ink);
    transition:
      background-color var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out),
      rotate var(--dur-base) var(--ease-out);
  }

  /* The row layout at `md` needs this the way any flex child holding text does — a
     long tool name would otherwise refuse to shrink below its own natural width and
     push the card wider than its grid cell. */
  .card__text {
    min-width: 0;
  }

  a.card:hover .card__icon {
    background-color: var(--color-signal-fill);
    color: var(--color-on-signal);
    rotate: -6deg;
  }

  .card__name {
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
  }

  .card__description {
    margin-top: var(--space-3xs);
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  .card__status {
    position: absolute;
    top: var(--space-md);
    right: var(--space-md);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }

  /* Bento sizing is desktop-only (the grid itself only spans cards from this width
     up, in index.astro) — below it every card renders identically regardless of the
     size it's been assigned, which is the "mobile view stays normal" promise. */
  @media (width >= 64rem) {
    .card[data-size='lg'] {
      --tool-icon-size: 72px;
      --tool-icon-glyph: 2.25rem;
      justify-content: center;
      padding: var(--space-lg);
    }

    .card[data-size='lg'] .card__name {
      font-size: var(--text-2xl);
    }

    .card[data-size='lg'] .card__description {
      margin-top: var(--space-2xs);
      font-size: var(--text-base);
    }

    /* Wide, not tall — the icon sits beside the text rather than above it, so the
       extra width reads as one deliberate row instead of a small card adrift in it. */
    .card[data-size='md'] {
      flex-direction: row;
      align-items: center;
      gap: var(--space-md);
    }

    .card[data-size='md'] .card__icon {
      margin-bottom: 0;
    }
  }
</style>
