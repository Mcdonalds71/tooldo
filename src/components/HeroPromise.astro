---
import { ArrowRightIcon } from '@phosphor-icons/react/dist/ssr';
---

<div class="promise-wrapper">
  <svg width="0" height="0" style="position: absolute;" aria-hidden="true">
    <defs>
      <clipPath id="hero-promise-clip" clipPathUnits="objectBoundingBox">
        <path
          d="
            M 0, 0.03
            Q 0,0 0.015,0
            L 0.94, 0
            Q 0.955,0 0.965,0.015
            L 0.99,0.065
            Q 1,0.08 1,0.095
            L 1, 0.97
            Q 1,1 0.985,1
            L 0.06, 1
            Q 0.045,1 0.035,0.985
            L 0.01,0.935
            Q 0,0.92 0,0.905
            Z
          "
        ></path>
      </clipPath>
    </defs>
  </svg>

  <article class="promise">
    <div class="promise__inner">
      <p class="promise__eyebrow">Runs locally &bull; No tracking &bull; Open source</p>

      <p class="promise__copy">
        Convert, compress, clean, and edit files directly in your browser. Everything runs
        on your device, so your files stay private. No accounts. No cloud processing.
      </p>

      <a class="promise__go" href="/privacy">
        <span class="promise__go-icon" aria-hidden>
          <ArrowRightIcon size="1rem" weight="bold" />
        </span>
        Read the privacy promise
      </a>
    </div>
  </article>
</div>

<style>
  .promise-wrapper {
    position: relative;
    width: 100%;
    filter: drop-shadow(4px 4px 0 var(--color-ink, #1c1a15));
  }

  .promise {
    position: relative;
    width: 100%;
    background-color: var(--color-ink, #1c1a15);
    padding: 2.5px;
    clip-path: url(#hero-promise-clip);
    display: flex;
  }

  .promise__inner {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
    padding: var(--space-lg);
    background-color: var(--color-card);
    clip-path: url(#hero-promise-clip);
  }

  /* Display face at reading case — it carries the claims, so it should read as a line
     of type rather than as a label shouting in caps. */
  .promise__eyebrow {
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    font-size: var(--text-sm);
    letter-spacing: normal;
    color: var(--color-ink);
    margin: 0;
  }

  .promise__copy {
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    text-align: justify;
    text-justify: inter-word;
    margin: 0;
  }

  /* The arrow keeps its weight, but the words carry the destination — an arrow alone
     tells a sighted reader nothing about where it goes. */
  .promise__go {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-top: auto;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .promise__go-icon {
    display: grid;
    place-items: center;
    width: var(--tap-target-min);
    height: var(--tap-target-min);
    border: var(--brut-border);
    border-radius: var(--radius-full);
    background-color: var(--color-ink);
    color: var(--color-paper);
    flex-shrink: 0;
    transition: translate var(--dur-base) var(--ease-out);
  }

  .promise__go:hover .promise__go-icon {
    translate: 3px 0;
  }

  @media (width < 56rem) {
    .promise-wrapper {
      filter: drop-shadow(3px 3px 0 var(--color-ink, #1c1a15));
    }

    .promise {
      padding: 2px;
    }

    .promise__inner {
      padding: var(--space-md);
      gap: var(--space-xs);
    }

    .promise__eyebrow {
      font-size: 0.8rem;
    }

    .promise__copy {
      font-size: 0.82rem;
      line-height: 1.45;
    }

    .promise__go {
      font-size: 0.8rem;
      margin-top: 0;
    }

    .promise__go-icon {
      width: 1.6rem;
      height: 1.6rem;
    }
  }
</style>
