---
import { ArrowRightIcon } from '@phosphor-icons/react/dist/ssr';
---

<article class="promise">
  <p class="promise__eyebrow">
    <span class="promise__dot" aria-hidden></span>
    Runs on your device
  </p>

  <p class="promise__copy">
    Ten tools that convert, compress, and clean up your files. The work happens right
    here on your device, so your files stay with you — and there's nothing to sign up for.
  </p>

  <div class="promise__foot">
    <a class="promise__go" href="/privacy" aria-label="Read the privacy promise">
      <ArrowRightIcon size="1.1rem" weight="bold" aria-hidden />
    </a>

    <ul class="promise__tags">
      <li>no ads</li>
      <li>no trackers</li>
      <li>works offline</li>
    </ul>
  </div>
</article>

<style>
  .promise {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-md);
    border: var(--card-border);
    border-radius: var(--bento-radius);
    box-shadow: var(--card-shadow);
    background-color: var(--color-card);
  }

  .promise__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }

  .promise__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: var(--radius-full);
    background-color: var(--color-signal);
  }

  .promise__copy {
    color: var(--color-ink-soft);
    text-wrap: pretty;
  }

  .promise__foot {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-top: auto;
    padding-top: var(--space-xs);
  }

  .promise__go {
    display: grid;
    place-items: center;
    width: var(--tap-target-min);
    height: var(--tap-target-min);
    border: var(--brut-border);
    border-radius: var(--radius-full);
    background-color: var(--color-ink);
    color: var(--color-paper);
    flex-shrink: 0;
    transition: translate var(--dur-base) var(--ease-out);
  }

  .promise__go:hover {
    translate: 3px 0;
  }

  .promise__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-ink-faint);
    list-style: none;
  }
</style>
