---
import {
  FilePdfIcon,
  FilmStripIcon,
  FrameCornersIcon,
  ImagesIcon,
  TableIcon,
} from '@phosphor-icons/react/dist/ssr';
import { formatBytes } from '../lib/formatBytes';

/**
 * The hero showpiece: a hand of files fanned under the headline, which deals out on
 * load and collects into a compressed result as you scroll. Two beats, no more.
 *
 * The fanned layout is the CSS state, so a reader with reduced motion or without
 * JavaScript sees the finished arrangement rather than an empty stage — GSAP animates
 * from a collapsed stack towards it.
 *
 * The numbers come from the same helper the tools use, so the claim on the landing
 * page is arithmetic rather than copywriting.
 */

const files = [
  { name: 'invoice.pdf', bytes: 1_100_000, out: 340_000, icon: FilePdfIcon },
  { name: 'beach.heic', bytes: 2_400_000, out: 410_000, icon: ImagesIcon },
  { name: 'screenshot.png', bytes: 820_000, out: 190_000, icon: FrameCornersIcon },
  { name: 'clip.mp4', bytes: 7_800_000, out: 820_000, icon: FilmStripIcon },
  { name: 'data.csv', bytes: 560_000, out: 96_000, icon: TableIcon },
];

const total = files.reduce((sum, file) => sum + file.bytes, 0);
const compressed = files.reduce((sum, file) => sum + file.out, 0);
const saved = Math.round((1 - compressed / total) * 100);
---

<div class="deck-stage">
  <ul class="deck" aria-label="Five everyday files, before and after">
    {
      files.map((file) => (
        <li class="deck__card">
          <span class="deck__icon" aria-hidden>
            <file.icon size="1.5rem" weight="duotone" />
          </span>
          <b class="deck__name">{file.name}</b>
          <span class="deck__size">{formatBytes(file.bytes)}</span>
        </li>
      ))
    }
  </ul>

  <p class="deck__result">
    <span>{formatBytes(total)}</span>
    <span class="deck__arrow" aria-hidden>&rarr;</span>
    <span>{formatBytes(compressed)}</span>
    <span class="deck__saved" data-saved={saved}>{saved}% smaller</span>
  </p>
</div>

<style>
  .deck-stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
    margin-top: var(--space-xl);
  }

  .deck {
    position: relative;
    width: 100%;
    height: 12rem;
    list-style: none;
  }

  /* Lifted off the floor so the tilted outer cards have room to dip without
     colliding with the line underneath. */
  .deck__card {
    position: absolute;
    left: 50%;
    bottom: var(--space-lg);
    width: var(--deck-card-width);
    margin-left: calc(var(--deck-card-width) / -2);
    padding: var(--space-sm);
    border: var(--card-border);
    border-radius: var(--card-radius);
    box-shadow: var(--card-shadow);
    background-color: var(--color-card);
    text-align: left;
  }

  /* Step out, drop along the arc, then tilt — the outer cards sit lowest. */
  .deck__card:nth-child(1) {
    transform: translateX(calc(var(--deck-shift) * -2)) translateY(var(--deck-arc))
      rotate(calc(var(--deck-tilt) * -2));
  }

  .deck__card:nth-child(2) {
    transform: translateX(calc(var(--deck-shift) * -1)) translateY(calc(var(--deck-arc) / 4))
      rotate(calc(var(--deck-tilt) * -1));
  }

  .deck__card:nth-child(3) {
    transform: translateX(0) translateY(0) rotate(0deg);
  }

  .deck__card:nth-child(4) {
    transform: translateX(var(--deck-shift)) translateY(calc(var(--deck-arc) / 4))
      rotate(var(--deck-tilt));
  }

  .deck__card:nth-child(5) {
    transform: translateX(calc(var(--deck-shift) * 2)) translateY(var(--deck-arc))
      rotate(calc(var(--deck-tilt) * 2));
  }

  .deck__icon {
    display: block;
    color: var(--color-signal-dark);
  }

  .deck__name {
    display: block;
    margin-top: var(--space-2xs);
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    font-size: var(--text-sm);
  }

  .deck__size {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-ink-faint);
  }

  .deck__result {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2xs);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  .deck__arrow {
    color: var(--color-signal-dark);
  }

  .deck__saved {
    padding: var(--space-3xs) var(--space-xs);
    border: var(--brut-border);
    border-radius: var(--radius-full);
    background-color: var(--color-signal);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
  }

  /* Three cards is all that reads as a hand at phone width. */
  @media (width < 48rem) {
    .deck {
      height: 11rem;
      --deck-card-width: 7.5rem;
      --deck-shift: 88%;
    }

    .deck__card:nth-child(1),
    .deck__card:nth-child(5) {
      display: none;
    }

    /* Narrower cards overlap less and carry smaller, tighter text, so the two
       cards behind still show a whole filename rather than a cut one. */
    .deck__card {
      padding: var(--space-2xs);
    }

    .deck__name {
      font-size: var(--text-xs);
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const stage = document.querySelector('.deck-stage');
  const cards = gsap.utils.toArray<HTMLElement>('.deck__card');
  const saved = document.querySelector<HTMLElement>('.deck__saved');

  if (stage && cards.length > 0 && saved) {
    const target = Number(saved.dataset['saved']);

    // matchMedia gates the whole showpiece on the motion preference and cleans up after
    // itself, so the CSS fan stays exactly as authored when motion is unwelcome.
    gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
      gsap.from(cards, {
        rotation: 0,
        y: 40,
        opacity: 0,
        duration: 0.55,
        ease: 'power3.out',
        stagger: 0.07,
      });

      const counter = { value: 0 };

      gsap.to(counter, {
        value: target,
        duration: 1.1,
        delay: 0.5,
        ease: 'power1.out',
        onUpdate: () => {
          saved.textContent = `${Math.round(counter.value)}% smaller`;
        },
      });

      // Beat two: scrolling gathers the hand back into a stack.
      gsap.to(cards, {
        rotation: 0,
        y: 18,
        scale: 0.92,
        ease: 'none',
        scrollTrigger: {
          trigger: stage,
          start: 'center 60%',
          end: 'bottom 15%',
          scrub: 0.6,
        },
      });
    });
  }
</script>
