---
import Hero from '../components/Hero.astro';
import StickerMarquee from '../components/StickerMarquee.astro';
import ToolCard, { type ToolCardSize } from '../components/ToolCard.astro';
import Reveal from '../design-system/motion/Reveal.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/site';
import { type ToolSlug, tools } from '../lib/tools';

/**
 * The bento sizing for the suite grid, desktop only (ToolCard and the grid itself both
 * gate the visual difference behind the same breakpoint — mobile renders every card
 * identically regardless of what's assigned here). Invoice Generator is the one `lg`
 * card by design; the two `md` cards reuse `POPULAR_SLUGS`' own "these three are
 * promoted" signal rather than inventing a second, unrelated notion of importance.
 */
const CARD_SIZE: Partial<Record<ToolSlug, ToolCardSize>> = {
  invoice: 'lg',
  pdf: 'md',
  images: 'md',
};

function cardSize(slug: ToolSlug): ToolCardSize {
  return CARD_SIZE[slug] ?? 'sm';
}
---

<BaseLayout title={`${SITE.name} — ${SITE.tagline}`}>
  <Hero />

  <section id="tools" class="tools">
    <div class="shell">
      <Reveal>
        <p class="eyebrow">the suite</p>
        <h2 class="tools__heading">Nine tools. One clean home.</h2>
        <p class="tools__sub">
          The everyday fixes you keep googling — gathered in one place, made properly, always free.
        </p>
      </Reveal>

      <ul class="tools__grid">
        {
          tools.map((tool) => (
            <li class="tools__item" data-size={cardSize(tool.slug)}>
              <ToolCard tool={tool} size={cardSize(tool.slug)} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Reveal>
    <StickerMarquee />
  </Reveal>
</BaseLayout>

<style>
  .tools {
    padding-block: var(--space-2xl);
    text-align: center;
  }

  .tools__heading {
    margin-top: var(--space-xs);
    font-size: var(--text-3xl);
    font-weight: var(--weight-bold);
  }

  .tools__sub {
    max-width: var(--width-prose);
    margin: var(--space-sm) auto 0;
    color: var(--color-ink-soft);
  }

  .tools__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(var(--grid-card-min), 1fr));
    gap: var(--space-sm);
    margin-top: var(--space-xl);
    text-align: start;
    list-style: none;
  }

  /* Bento, desktop only — a phone screen has no room for a card twice the width of
     its neighbours to read as anything but cramped, so under this width every card
     stays the plain equal-sized grid above. */
  @media (width >= 64rem) {
    .tools__grid {
      grid-template-columns: repeat(4, 1fr);
      grid-auto-flow: dense;
    }

    .tools__item[data-size='lg'] {
      grid-column: span 2;
      grid-row: span 2;
    }

    .tools__item[data-size='md'] {
      grid-column: span 2;
    }
  }
</style>
