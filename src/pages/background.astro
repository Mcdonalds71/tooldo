---
import ToolLayout, { type FaqEntry } from '../layouts/ToolLayout.astro';
import { BackgroundTool } from '../tools/background/BackgroundTool';
import '../tools/background/background.css';

const description =
  'Drop a photo and get back a transparent PNG with the background erased — an on-device AI model does the cutting, right in your browser. Your photo never leaves your device.';

const steps = [
  {
    title: 'Drop your photo',
    body: 'Any subject works, not just people — PNG, JPEG, WebP, or HEIC.',
  },
  {
    title: 'The model erases the background',
    body: 'The first run downloads a small AI model once; every run after that is instant and works offline.',
  },
  {
    title: 'Download the cutout',
    body: 'A transparent PNG, ready to drop onto anything.',
  },
];

const faq: readonly FaqEntry[] = [
  {
    question: 'Does my photo get uploaded?',
    answer:
      "No. The photo is decoded and processed by an AI model running entirely in this tab, and never leaves your device. The only thing this tool fetches from the network is the model itself — a public file with nothing of yours in it — and only once. After that it's cached and the tool works offline.",
  },
  {
    question: 'Why does the first run take longer?',
    answer:
      "It's downloading the model — around 40 MB, since a background remover this capable doesn't fit in the few kilobytes of code the other tools' codecs do. Your browser caches it, so every photo after the first, in this session or a future one, starts right away.",
  },
  {
    question: 'Does it only work on people?',
    answer:
      "No. It's a general-purpose model, not a face or portrait detector — it finds whatever the clear subject of the photo is, whether that's a person, a product, an animal, or an object, and cuts around that.",
  },
  {
    question: 'What do I get back?',
    answer:
      'A PNG with a transparent background, sized to match your original photo. PNG is the only format here, because it is the one that can actually hold transparency.',
  },
  {
    question: 'Can it open HEIC photos from an iPhone?',
    answer: 'Yes. Drop a HEIC or HEIF file straight from your camera roll.',
  },
  {
    question: 'How many photos can I do at once?',
    answer:
      'Up to 20 in a batch, each up to 50 MB. Each photo runs the model in turn, so a batch takes noticeably longer than converting the same number of images would.',
  },
];
---

<ToolLayout
  slug="background"
  title="Remove the background from a photo — tooldo"
  description={description}
  steps={steps}
  faq={faq}
>
  {
    /* client:load, not client:visible: matches every other tool — the island is the
       whole reason the route exists and opens above the fold. */
  }
  <BackgroundTool client:load />
</ToolLayout>
